# === API KEYS ===
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# === MODELS ===
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4.1-2025-04-14
CLAIM_EXTRACTION_MODEL=claude-sonnet-4-5-20250929
CLAIM_VALIDATION_MODEL=gpt-5-mini-2025-08-07
JUDGE_MODEL=claude-opus-4-5-20251101
NLI_MODEL=Xenova/nli-deberta-v3-small

# === VECTOR DATABASE (Qdrant) ===
QDRANT_URL=http://localhost:6333
PAPER_COLLECTION_NAME=papers
REVIEW_COLLECTION_NAME=human_reviews

# === DATASET ===
DATASET_PATH=./dataset
MAX_PAPERS=65

# === CHUNKING ===
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === RAG ===
TOP_K=5

# === LLM JUDGE ===
TOP_K_JUDGE=7

# === NLI ===
NLI_ENTAILMENT_THRESHOLD=0.70
NLI_CONTRADICTION_THRESHOLD=0.50

# === OUTPUT ===
RESULTS_PATH=./results
